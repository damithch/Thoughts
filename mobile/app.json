{
  "expo": {
    "name": "Thoughts",
    "slug": "thoughts",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.damithch.thoughts"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C2433",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.damithch.thoughts",
      "versionCode": 7,
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0C2433"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Thoughts to use the microphone so you can speak a thought.",
          "speechRecognitionPermission": "Allow Thoughts to turn your speech into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "scheme": "thoughts",
    "experiments": {
      "typedRoutes": true
    }
  }
}
